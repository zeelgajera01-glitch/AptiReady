<?xml version='1.0' encoding='utf-8'?>
<resources>
  <style name="Text.AptiRise.Body" parent="android:Widget.TextView">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:lineSpacingExtra">4dp</item>
    <item name="android:includeFontPadding">false</item>
  </style>
  <style name="Text.AptiRise.Title" parent="Text.AptiRise.Body">
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textSize">30sp</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:lineSpacingExtra">2dp</item>
    <item name="android:letterSpacing">-0.02</item>
  </style>
  <style name="Text.AptiRise.Section" parent="Text.AptiRise.Title">
    <item name="android:textSize">20sp</item>
    <item name="android:letterSpacing">-0.01</item>
  </style>
  <style name="Text.AptiRise.Question" parent="Text.AptiRise.Body">
    <item name="android:textSize">20sp</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:lineSpacingExtra">6dp</item>
  </style>
  <style name="Text.AptiRise.Eyebrow" parent="Text.AptiRise.Body">
    <item name="android:textSize">11sp</item>
    <item name="android:letterSpacing">0.08</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:lineSpacingExtra">2dp</item>
  </style>
  <style name="Text.AptiRise.Number" parent="Text.AptiRise.Title">
    <item name="android:textSize">34sp</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>
  <style name="Widget.AptiRise.Card" parent="Widget.Material3.CardView.Elevated">
    <item name="cardCornerRadius">24dp</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">1dp</item>
    <item name="cardBackgroundColor">?attr/colorSurface</item>
    <item name="strokeColor">@color/atelier_border</item>
  </style>
  <style name="Widget.AptiRise.Button.Primary" parent="Widget.Material3.Button">
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:minHeight">54dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="cornerRadius">16dp</item>
    <item name="backgroundTint">@color/atelier_button_tint</item>
    <item name="android:textColor">@color/atelier_button_text</item>
    <item name="android:letterSpacing">0.01</item>
  </style>
  <style name="Widget.AptiRise.Button.Soft" parent="Widget.AptiRise.Button.Primary">
    <item name="backgroundTint">@color/atelier_chip_background</item>
    <item name="android:textColor">@color/atelier_soft_button_text</item>
  </style>
  <style name="Widget.AptiRise.Button.Peach" parent="Widget.AptiRise.Button.Primary">
    <item name="backgroundTint">@color/atelier_peach</item>
    <item name="android:textColor">@color/atelier_on_peach</item>
  </style>
  <style name="Widget.AptiRise.Button.Text" parent="Widget.Material3.Button.TextButton">
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">15sp</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="cornerRadius">16dp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
  <style name="Widget.AptiRise.Chip" parent="Widget.Material3.Chip.Filter">
    <item name="chipBackgroundColor">@color/atelier_chip_background</item>
    <item name="android:textColor">@color/atelier_chip_text</item>
    <item name="chipStrokeWidth">1dp</item>
    <item name="chipCornerRadius">20dp</item>
    <item name="chipMinHeight">40dp</item>
    <item name="ensureMinTouchTargetSize">true</item>
    <item name="checkedIconVisible">false</item>
    <item name="android:textSize">13sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="chipStrokeColor">@color/atelier_border</item>
  </style>
  <style name="Widget.AptiRise.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxBackgroundColor">?attr/colorSurface</item>
    <item name="boxStrokeColor">@color/aptirise_input_stroke</item>
    <item name="boxCornerRadiusTopStart">16dp</item>
    <item name="boxCornerRadiusTopEnd">16dp</item>
    <item name="boxCornerRadiusBottomStart">16dp</item>
    <item name="boxCornerRadiusBottomEnd">16dp</item>
    <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>
    <item name="hintEnabled">false</item>
  </style>
  <style name="Widget.AptiRise.DemoBadge" parent="Text.AptiRise.Eyebrow">
    <item name="android:background">@drawable/atelier_badge</item>
    <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    <item name="android:paddingStart">10dp</item>
    <item name="android:paddingEnd">10dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
  </style>
  <style name="ThemeOverlay.AptiRise.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.AptiRise.BottomSheet</item>
  </style>
  <style name="Widget.AptiRise.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
    <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AptiRise.Sheet</item>
    <item name="backgroundTint">?attr/colorSurface</item>
  </style>
  <style name="ShapeAppearance.AptiRise.Sheet" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSizeTopLeft">28dp</item>
    <item name="cornerSizeTopRight">28dp</item>
    <item name="cornerSizeBottomLeft">0dp</item>
    <item name="cornerSizeBottomRight">0dp</item>
  </style>
  <style name="ThemeOverlay.AptiRise.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="colorSurface">@color/atelier_surface</item>
    <item name="colorPrimary">@color/primary</item>
  </style>
  <style name="Widget.AptiRise.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
    <item name="android:color">@color/brand_nav_indicator</item>
  </style>
  <style name="Widget.AptiRise.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxBackgroundColor">?attr/colorSurface</item>
    <item name="boxStrokeColor">@color/aptirise_input_stroke</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>
    <item name="boxCornerRadiusTopStart">16dp</item>
    <item name="boxCornerRadiusTopEnd">16dp</item>
    <item name="boxCornerRadiusBottomStart">16dp</item>
    <item name="boxCornerRadiusBottomEnd">16dp</item>
    <item name="hintTextColor">?attr/colorPrimary</item>
  </style>
  <style name="Widget.AptiRise.Button.Outline" parent="Widget.AptiRise.Button.Primary">
    <item name="backgroundTint">@android:color/transparent</item>
    <item name="strokeColor">@color/aptirise_input_stroke</item>
    <item name="strokeWidth">1dp</item>
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="iconTint">?attr/colorPrimary</item>
  </style>
</resources>
