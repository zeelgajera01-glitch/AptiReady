  <string name="privacy_intro">AptiRise works without an account. You can practise, take mock tests and review your progress without providing a name, email address or password.</string>
  <string name="privacy_local_title">Learning stays on this device</string>
  <string name="privacy_local_body">Practice attempts, answers, scores, bookmarks, hint allowance and appearance preferences are stored on this device. They are not uploaded or restored across devices.</string>
  <string name="privacy_network_title">Optional update checks</string>
  <string name="privacy_network_body">The app can contact Firebase Remote Config to check the minimum supported version. Learning records are not sent with this check. No login, advertising or cloud synchronization is used.</string>
  <string name="privacy_delete_title">Managing local data</string>
