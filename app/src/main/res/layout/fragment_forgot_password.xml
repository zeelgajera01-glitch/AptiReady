<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/spacing_24dp" android:paddingTop="@dimen/spacing_24dp" android:paddingEnd="@dimen/spacing_24dp" android:paddingBottom="@dimen/spacing_32dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/atelier_circle" android:contentDescription="@string/cd_back_button" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:padding="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/aptirise_hero_gradient" android:padding="24dp" android:layout_marginBottom="4dp">
      <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/logo" android:contentDescription="@string/cd_app_logo" android:layout_marginBottom="12dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_12dp" android:text="Reset Password" android:textColor="@color/brand_on_gradient" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Enter your account email below. We'll send instructions to reset your password." android:textColor="@color/brand_on_gradient" android:textSize="14sp"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_confirmation" style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp" android:visibility="gone" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorSecondaryContainer" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset Request Sent" android:textColor="?attr/colorOnSecondaryContainer" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="If an account exists for this email address, password reset instructions have been sent to your inbox." android:textColor="?attr/colorOnSecondaryContainer" android:textSize="13sp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/layout_email" style="@style/Widget.AptiRise.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_24dp" android:hint="Email Address" app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" android:textSize="15sp" android:minHeight="56dp" android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp" android:indeterminate="true" android:visibility="invisible"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_send_reset" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_12dp" android:text="Send Reset Link" app:cornerRadius="16dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_back_login" style="@style/Widget.AptiRise.Button.Text" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_12dp" android:text="Back to Sign In" app:cornerRadius="16dp"/>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
