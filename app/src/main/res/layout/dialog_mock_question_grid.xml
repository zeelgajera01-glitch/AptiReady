<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?attr/colorSurface" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:text="Question Palette" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:layout_weight="1"/>
    <ImageButton android:id="@+id/btn_close_mock_grid" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:contentDescription="Close navigator"/>
  </LinearLayout>
  <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no"/>
  <TextView android:text="Answered · Unanswered · Marked for review" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="12sp"/>
  <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_mock_question_grid" android:layout_width="match_parent" android:layout_height="240dp" app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" app:spanCount="5"/>
  <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no"/>
  <com.google.android.material.button.MaterialButton android:text="Submit Test Now" android:id="@+id/btn_submit_mock_from_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Primary" app:cornerRadius="16dp"/>
</LinearLayout>
