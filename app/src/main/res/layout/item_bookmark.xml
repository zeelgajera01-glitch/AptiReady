<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/card_bookmark_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/tv_bookmark_topic" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:padding="8dp" android:background="@drawable/atelier_badge" tools:text="QUANT · PERCENTAGES" android:layout_weight="1"/>
      <ImageButton android:id="@+id/btn_remove_bookmark" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_atelier_bookmark" app:tint="?attr/colorPrimary" android:contentDescription="Remove saved question"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_bookmark_question_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Question" tools:text="A shopkeeper marks an article 40% above cost price."/>
    <Space android:layout_width="1dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/layout_solution_container" android:visibility="gone">
      <TextView android:id="@+id/tv_correct_option_label" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:padding="14dp" android:background="@drawable/atelier_success_panel" android:textColor="@color/atelier_success"/>
      <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
      <TextView android:text="Solution" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="18sp"/>
      <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/tv_bookmark_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:padding="14dp" android:background="@drawable/atelier_soft_panel" android:textColor="?attr/colorOnPrimaryContainer" android:lineSpacingExtra="7dp"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
    <com.google.android.material.button.MaterialButton android:text="Reveal Solution &amp; Explanation" android:id="@+id/btn_reveal_solution" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" app:cornerRadius="16dp"/>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
