<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/spacing_20dp" android:paddingTop="@dimen/spacing_16dp" android:paddingEnd="@dimen/spacing_20dp" android:background="?android:attr/colorBackground">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:background="@drawable/aptirise_hero_gradient" android:padding="20dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/progress_title" android:textColor="@color/brand_on_gradient" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Track speed, accuracy, and topic strengths." android:textColor="@color/brand_on_gradient_muted" android:textSize="13sp"/>
    </LinearLayout>
  </RelativeLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_16dp" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_sample_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/spacing_16dp" android:paddingTop="@dimen/spacing_12dp" android:paddingEnd="@dimen/spacing_16dp" android:paddingBottom="@dimen/spacing_12dp" android:text="@string/toggle_sample_data" android:textColor="?attr/colorOnSurface" android:textSize="14sp" android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_view_attempt_history" style="@style/Widget.AptiRise.Button.Outline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_8dp" android:text="View Full Attempt History" app:cornerRadius="16dp"/>
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/layout_zero_data" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_24dp">
      <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@null" android:src="@drawable/ic_progress" app:tint="?attr/colorSecondary" android:background="@drawable/aptirise_logo_halo" android:padding="16dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp" android:text="@string/zero_data_title" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_8dp" android:gravity="center" android:text="@string/zero_data_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/scroll_sample_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="@dimen/spacing_24dp" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewElevatedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorSecondaryContainer" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_data_note" android:textColor="?attr/colorOnSecondaryContainer" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sample_data_disclaimer" android:textColor="?attr/colorOnSecondaryContainer" android:textSize="12sp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_16dp" android:baselineAligned="false" android:orientation="horizontal">
          <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/spacing_8dp" android:layout_weight="1" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
              <TextView android:id="@+id/tv_real_accuracy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="?attr/colorPrimary" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/accuracy_label" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
          <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_8dp" android:layout_weight="1" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
              <TextView android:id="@+id/tv_real_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Days" android:textColor="?attr/colorSecondary" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02"/>
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/streak_label" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/category_mastery_header" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="@string/category_quant" android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
              <TextView android:id="@+id/tv_quant_mastery_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0% (Newbie)" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_quant_mastery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:progress="0" app:indicatorColor="?attr/colorPrimary" app:trackCornerRadius="3dp" app:trackColor="@color/atelier_track" app:trackThickness="6dp"/>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="@string/category_logical" android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
              <TextView android:id="@+id/tv_logical_mastery_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0% (Newbie)" android:textColor="?attr/colorSecondary" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_logical_mastery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:progress="0" app:indicatorColor="?attr/colorSecondary" app:trackCornerRadius="3dp" app:trackColor="@color/atelier_track" app:trackThickness="6dp"/>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="@string/category_verbal" android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
              <TextView android:id="@+id/tv_verbal_mastery_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0% (Newbie)" android:textColor="@color/difficulty_easy" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            </RelativeLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_verbal_mastery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:progress="0" app:indicatorColor="@color/difficulty_easy" app:trackCornerRadius="3dp" app:trackColor="@color/atelier_track" app:trackThickness="6dp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </FrameLayout>
</LinearLayout>
