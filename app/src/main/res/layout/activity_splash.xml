<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/splash_background">
 <com.aptirise.app.ui.common.SplashBackdrop android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.78"/>
  <ImageView android:id="@+id/splash_logo" android:layout_width="104dp" android:layout_height="104dp" android:src="@drawable/logo" android:contentDescription="@string/cd_app_logo"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Title" android:text="@string/app_name" android:gravity="center" android:fontFamily="sans-serif-black" android:textSize="36sp" android:textColor="@color/splash_ink"/>
  <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:text="@string/rise_tagline" android:gravity="center" android:textColor="@color/splash_muted" android:textSize="16sp"/>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.9"/>
  <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/splash_progress" android:layout_width="32dp" android:layout_height="32dp" android:indeterminate="true" app:indicatorColor="#338BFF" app:trackColor="@color/splash_wave_accent" app:indicatorSize="32dp" app:trackThickness="3dp"/>
  <Space android:layout_width="1dp" android:layout_height="18dp" android:importantForAccessibility="no"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:text="@string/journey_preparing" android:id="@+id/splash_message" android:gravity="center" android:textColor="@color/splash_muted" android:textSize="12sp" android:accessibilityLiveRegion="polite"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/splash_retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/content_retry" android:visibility="gone"/>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.25"/>
 </LinearLayout>
</FrameLayout>