<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground" android:paddingStart="20dp" android:paddingEnd="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="12dp">
    <ImageButton android:id="@+id/btn_exit_mock" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:contentDescription="Exit mock test" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp" android:layout_weight="1">
      <TextView android:text="Test Simulation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" />
      <TextView android:id="@+id/tv_mock_test_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:maxLines="2" tools:text="Full Mock Exam 01" />
    </LinearLayout>
    <ImageButton android:id="@+id/btn_mock_mark_review" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_atelier_flag" app:tint="?attr/colorPrimary" android:contentDescription="Mark for review" />
  </LinearLayout>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@null" android:src="@drawable/ic_timer" app:tint="?attr/colorPrimary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
              <TextView android:id="@+id/tv_mock_timer" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:fontFeatureSettings="tnum" tools:text="18:40" />
              <TextView android:text="TIME REMAINING" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" />
            </LinearLayout>
          </LinearLayout>
          <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
          <TextView android:id="@+id/tv_mock_test_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="12sp" tools:text="+1 per correct answer · No negative marking" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_mock_question_counter" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="17sp" tools:text="Question 7 of 20" android:layout_weight="1" android:visibility="gone" android:importantForAccessibility="no" />
        <TextView android:text="MARKED FOR REVIEW" android:id="@+id/tv_mock_review_status" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:visibility="gone" android:textColor="@color/difficulty_medium" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no" />
      <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/mock_progress_bar" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackThickness="6dp" app:trackCornerRadius="3dp" app:indicatorColor="?attr/colorPrimary" app:trackColor="@color/atelier_track" android:indeterminate="false" android:max="100" />
      <Space android:layout_width="1dp" android:layout_height="18dp" android:importantForAccessibility="no" />
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/aptirise_question_panel">
          <TextView android:id="@+id/tv_mock_question_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Question" tools:text="A train running at 54 km/h crosses a 250 m platform in 30 seconds. How long does it take to overtake a cyclist travelling at 18 km/h?" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_mock_option_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
            <TextView android:text="A" android:id="@+id/tv_mock_badge_a" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:id="@+id/tv_mock_option_a_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="20 seconds" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_mock_option_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
            <TextView android:text="B" android:id="@+id/tv_mock_badge_b" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:id="@+id/tv_mock_option_b_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="25 seconds" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_mock_option_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
            <TextView android:text="C" android:id="@+id/tv_mock_badge_c" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:id="@+id/tv_mock_option_c_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="18.5 seconds" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_mock_option_d" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
            <TextView android:text="D" android:id="@+id/tv_mock_badge_d" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView android:id="@+id/tv_mock_option_d_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="32 seconds" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.button.MaterialButton android:text="Clear Selection" android:id="@+id/btn_clear_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Text" app:cornerRadius="16dp" />
      <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no" />
      <com.google.android.material.button.MaterialButton android:text="Question Palette" android:id="@+id/btn_mock_navigator" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" app:icon="@drawable/ic_atelier_grid" app:cornerRadius="16dp" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/colorSurface" android:paddingStart="8dp" android:paddingEnd="8dp">
    <com.google.android.material.button.MaterialButton android:text="Prev" android:id="@+id/btn_prev_mock" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
    <com.google.android.material.button.MaterialButton android:text="Next" android:id="@+id/btn_next_mock" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" android:layout_weight="1" android:layout_marginStart="8dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
    <com.google.android.material.button.MaterialButton android:text="Submit" android:id="@+id/btn_submit_mock_test" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Primary" android:layout_weight="1" android:layout_marginStart="8dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
  </LinearLayout>
</LinearLayout>