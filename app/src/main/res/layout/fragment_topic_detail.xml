<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="16dp">
      <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:contentDescription="Navigate back"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
        <TextView android:text="AptiRise" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section"/>
        <TextView android:text="PRACTICE SETUP" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow"/>
      </LinearLayout>
    </LinearLayout>
    <TextView android:text="Topic details" android:id="@+id/tv_header_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/aptirise_hero_gradient" android:padding="24dp" android:layout_marginBottom="16dp">
      <TextView android:id="@+id/tv_category_name" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:background="@drawable/atelier_peach_badge" android:textColor="@color/atelier_on_peach" android:padding="9dp" tools:text="QUANTITATIVE APTITUDE"/>
      <Space android:layout_width="1dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/tv_topic_full_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Title" tools:text="Percentages &amp; Successive Change" android:textColor="@color/brand_on_gradient"/>
      <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/tv_topic_description" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" tools:text="Master percentage change and rapid mental calculation." android:textColor="@color/brand_on_gradient_muted"/>
      <Space android:layout_width="1dp" android:layout_height="22dp" android:importantForAccessibility="no"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/atelier_soft" app:strokeColor="@color/atelier_border">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@null" android:src="@drawable/ic_book" app:tint="?attr/colorPrimary"/>
          <TextView android:text="Formula guide" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:layout_weight="1"/>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/tv_formula_content" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnPrimaryContainer" android:lineSpacingExtra="7dp" tools:text="Percentage = (Value / Total) × 100%"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no"/>
    <TextView android:text="Difficulty" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section"/>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false" android:clipToPadding="false">
      <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_difficulty" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:chipSpacingHorizontal="6dp">
        <com.google.android.material.chip.Chip android:id="@+id/chip_diff_all" android:text="All" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="true"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_diff_easy" android:text="Easy" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_diff_medium" android:text="Medium" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_diff_hard" android:text="Hard" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
      </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <Space android:layout_width="1dp" android:layout_height="22dp" android:importantForAccessibility="no"/>
    <TextView android:text="Questions per session" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section"/>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false" android:clipToPadding="false">
      <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_length" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:chipSpacingHorizontal="6dp">
        <com.google.android.material.chip.Chip android:id="@+id/chip_len_5" android:text="5 Qs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_len_10" android:text="10 Qs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="true"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_len_15" android:text="15 Qs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
        <com.google.android.material.chip.Chip android:id="@+id/chip_len_20" android:text="20 Qs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false"/>
      </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <Space android:layout_width="1dp" android:layout_height="20dp" android:importantForAccessibility="no"/>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/atelier_soft" app:strokeColor="@color/atelier_border">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@null" android:src="@drawable/ic_timer" app:tint="?attr/colorPrimary"/>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:text="Learn at your pace" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="17sp"/>
            <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no"/>
            <TextView android:text="Practice includes hints and explanations." android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout android:id="@+id/banner_ad_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" android:visibility="gone"/>
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
    <com.google.android.material.button.MaterialButton android:text="Start Practice" android:id="@+id/btn_start_practice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Primary" app:cornerRadius="16dp"/>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
    <TextView android:text="Your progress is saved as you practice." android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:gravity="center"/>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
