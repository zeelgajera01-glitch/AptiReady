<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="16dp">
      <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:background="@null" android:src="@drawable/logo" android:contentDescription="@string/cd_app_logo" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
        <TextView android:text="AptiRise" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" />
        <TextView android:text="HOME" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/aptirise_hero_gradient" android:padding="24dp" android:layout_marginBottom="20dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A LITTLE PRACTICE. A BIGGER FUTURE." android:textColor="@color/brand_on_gradient_muted" android:layout_marginBottom="12dp" android:textSize="10sp" style="@style/Text.AptiRise.Eyebrow" />
      <TextView android:text="Ready to rise?" android:id="@+id/tv_home_greeting" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Title" android:textColor="@color/brand_on_gradient" android:textSize="28sp" />
      <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
      <TextView android:text="@string/app_tagline" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textStyle="normal" android:textSize="18sp" android:textColor="@color/brand_on_gradient_muted" />
      <Space android:layout_width="1dp" android:layout_height="24dp" android:importantForAccessibility="no" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_resume_practice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/atelier_hero" android:visibility="gone" app:strokeColor="@color/atelier_border">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/aptirise_hero_gradient">
        <TextView android:text="PRACTICE · IN PROGRESS" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:textColor="@color/brand_on_gradient_muted" />
        <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tv_resume_topic_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Title" android:textSize="25sp" android:textColor="@color/brand_on_gradient" tools:text="Profit and Loss" />
        <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tv_resume_progress_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="@color/brand_on_gradient_muted" tools:text="Question 3 of 10" />
        <Space android:layout_width="1dp" android:layout_height="16dp" android:importantForAccessibility="no" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/resume_progress" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackThickness="6dp" app:trackCornerRadius="3dp" app:indicatorColor="@color/brand_mint" app:trackColor="@color/brand_gradient_center" android:indeterminate="false" android:max="100" />
        <Space android:layout_width="1dp" android:layout_height="18dp" android:importantForAccessibility="no" />
        <com.google.android.material.button.MaterialButton android:text="Resume Practice  →" android:id="@+id/btn_resume_session" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Peach" app:cornerRadius="16dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_daily_challenge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/secondary_container" app:strokeColor="@color/atelier_border">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:text="DAILY SPRINT" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:textColor="?attr/colorSecondary" />
        <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView android:text="Quantitative Challenge" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="19sp" />
            <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no" />
            <TextView android:text="Build speed with focused topic practice." android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="14sp" />
          </LinearLayout>
          <com.google.android.material.button.MaterialButton android:text="Start" android:id="@+id/btn_daily_challenge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" android:layout_marginStart="12dp" app:cornerRadius="16dp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
    <TextView android:text="Explore your subjects" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" />
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/container_categories">
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_category_quant" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_category_quant" app:tint="?attr/colorPrimary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_weight="1">
              <TextView android:text="Quantitative Aptitude" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="18sp" />
              <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no" />
              <TextView android:text="Numbers, arithmetic and algebra" android:id="@+id/tv_quant_catalog_count" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="8dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorPrimary" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_category_logical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_category_logical" app:tint="?attr/colorPrimary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_weight="1">
              <TextView android:text="Logical Reasoning" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="18sp" />
              <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no" />
              <TextView android:text="Patterns, deductions and directions" android:id="@+id/tv_logical_catalog_count" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="8dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorPrimary" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_category_verbal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_category_verbal" app:tint="?attr/colorPrimary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_weight="1">
              <TextView android:text="Verbal Ability" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="18sp" />
              <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no" />
              <TextView android:text="Grammar, vocabulary and comprehension" android:id="@+id/tv_verbal_catalog_count" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="8dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorPrimary" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_quick_quiz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/atelier_soft" android:layout_marginEnd="8dp" android:layout_weight="1" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@null" android:src="@drawable/ic_timer" app:tint="?attr/colorPrimary" />
          <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
          <TextView android:text="Quick Practice" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="20sp" />
          <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
          <TextView android:text="A short topic session" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" />
          <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
          <com.google.android.material.button.MaterialButton android:text="Start" android:id="@+id/btn_quick_quiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" app:cornerRadius="16dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_mock_tests" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/atelier_soft" android:layout_marginStart="8dp" android:layout_weight="1" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@null" android:src="@drawable/ic_tests" app:tint="?attr/colorPrimary" />
          <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
          <TextView android:text="Full Mock Exam" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="20sp" />
          <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
          <TextView android:text="Timed exam simulation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" />
          <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
          <com.google.android.material.button.MaterialButton android:text="View Tests" android:id="@+id/btn_mock_catalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" app:cornerRadius="16dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/layout_continue_learning" android:visibility="gone">
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <TextView android:text="CONTINUE LEARNING" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" />
          <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no" />
          <TextView android:id="@+id/tv_recent_topic_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" tools:text="Direction Sense" />
          <Space android:layout_width="1dp" android:layout_height="6dp" android:importantForAccessibility="no" />
          <TextView android:id="@+id/tv_recent_topic_sub" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" tools:text="Logical Reasoning" />
          <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
          <com.google.android.material.button.MaterialButton android:text="Continue Learning" android:id="@+id/btn_continue_topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Text" app:cornerRadius="16dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
