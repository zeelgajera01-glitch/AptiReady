<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/card_review_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/tv_review_status_badge" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:padding="8dp" android:background="@drawable/atelier_badge" tools:text="INCORRECT" android:layout_weight="1"/>
      <ImageButton android:id="@+id/btn_review_bookmark" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_atelier_bookmark" app:tint="?attr/colorPrimary" android:contentDescription="Toggle saved question"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="14dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_review_question_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Question" tools:text="1. A price rises by 20% and falls by 10%."/>
    <Space android:layout_width="1dp" android:layout_height="18dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_user_selected_answer" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:padding="14dp" android:background="@drawable/atelier_soft_panel" tools:text="Your answer: B · 10%"/>
    <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_correct_answer_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:padding="14dp" android:textColor="@color/atelier_success" android:background="@drawable/atelier_success_panel" tools:text="Correct answer: A · 8%"/>
    <Space android:layout_width="1dp" android:layout_height="22dp" android:importantForAccessibility="no"/>
    <TextView android:text="Step-by-step explanation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="19sp"/>
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_review_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:padding="16dp" android:textColor="?attr/colorOnPrimaryContainer" android:background="@drawable/atelier_soft_panel" android:lineSpacingExtra="7dp" tools:text="Start with 100. After a 20% rise: 120. After a 10% fall: 108. Net change: +8%."/>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
