<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/spacing_24dp" android:paddingTop="@dimen/spacing_32dp" android:paddingEnd="@dimen/spacing_24dp" android:paddingBottom="@dimen/spacing_32dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_firebase_warning" style="?attr/materialCardViewElevatedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_20dp" android:visibility="gone" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorSecondaryContainer" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline Demo Mode (Firebase Unconfigured)" android:textColor="?attr/colorOnSecondaryContainer" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tv_config_warning_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/colorOnSecondaryContainer" android:textSize="12sp" tools:text="Please add google-services.json to the app/ directory as detailed in FIREBASE_SETUP.md to enable Cloud Auth."/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/aptirise_hero_gradient" android:padding="24dp" android:layout_marginBottom="20dp">
      <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_marginTop="0dp" android:contentDescription="@string/cd_app_logo" android:src="@drawable/logo" android:layout_gravity="center_horizontal"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp" android:text="@string/app_name" android:textColor="@color/brand_on_gradient" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:gravity="center"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/app_tagline" android:textColor="@color/brand_on_gradient" android:textSize="15sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:gravity="center" android:lineSpacingExtra="4dp" android:text="Master quantitative aptitude, logical reasoning, and verbal skills with adaptive daily practice." android:textColor="@color/brand_on_gradient" android:textSize="14sp"/>
      <Space android:layout_width="1dp" android:layout_height="20dp" android:importantForAccessibility="no"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Learn. Practice. Rise." android:gravity="center" android:textColor="@color/brand_on_gradient" style="@style/Text.AptiRise.Section"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/atelier_soft_panel" android:padding="20dp" android:layout_marginBottom="20dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your next step starts here" android:textSize="18sp" style="@style/Text.AptiRise.Section"/>
      <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01   Focused topic practice&#10;02   Timed mock tests&#10;03   Progress you can track" android:lineSpacingExtra="8dp" style="@style/Text.AptiRise.Body"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_google_sign_in" style="@style/Widget.AptiRise.Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginBottom="@dimen/spacing_12dp" android:text="Continue with Google" android:textColor="?attr/colorOnPrimary" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" app:icon="@drawable/ic_sparkles" app:iconGravity="textStart" app:iconPadding="8dp" app:iconTint="?attr/colorOnPrimary"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_8dp" android:indeterminate="true" android:visibility="invisible"/>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
