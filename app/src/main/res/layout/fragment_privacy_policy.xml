<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/spacing_16dp" android:paddingTop="@dimen/spacing_12dp" android:paddingEnd="@dimen/spacing_16dp" android:paddingBottom="@dimen/spacing_12dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:background="@drawable/atelier_circle" android:contentDescription="@string/cd_back_button" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:padding="12dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Privacy Policy" android:textColor="?attr/colorOnSurface" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
  </RelativeLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" />
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="@dimen/spacing_20dp" android:paddingTop="@dimen/spacing_16dp" android:paddingEnd="@dimen/spacing_20dp" android:paddingBottom="@dimen/spacing_32dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AptiRise Privacy Policy" android:textColor="?attr/colorPrimary" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Effective Date: October 18, 2026 | Package: com.aptirise.app" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="1. Introduction" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="Welcome to AptiRise. We respect your personal privacy and are committed to protecting the data you share with us. This Privacy Policy explains how AptiRise collects, uses, stores, and discloses information when you use our Android mobile application and associated services.\n\nBy installing or using AptiRise, you agree to the collection and use of information in accordance with this policy." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="2. Information We Collect" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="A. Account &amp; Profile Information" android:textColor="?attr/colorSecondary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:text="When you register for an account or sign in using Firebase Authentication, we collect:\n• Email Address: Used for account registration, sign-in authentication, email verification, and password recovery.\n• Display Name: Used to personalize your profile and progress reports within the app.\n• Daily Learning Target: Stored in Cloud Firestore to customize your daily question recommendations." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="B. Local Practice &amp; Test Progress" android:textColor="?attr/colorSecondary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:text="AptiRise stores learning data on your device using Android Room Database and DataStore Preferences, including:\n• Practice session attempts, correct/incorrect responses, and timestamps.\n• Mock test scores and question completion history.\n• Saved question bookmarks and custom app appearance/theme settings." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="C. Learning Data on This Device" android:textColor="?attr/colorSecondary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:text="Practice attempts, mock test results, and question bookmarks are stored locally on this device. They are not uploaded or restored across devices." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="D. Account Security" android:textColor="?attr/colorSecondary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:text="Firebase Authentication handles account sign-in. Your account profile is stored separately from learning records, which stay on this device." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="3. How We Use Your Information" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="Account information is used for sign-in, profile management, and account security. Local learning data powers practice sessions, mock test results, bookmarks, and progress statistics." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="4. Third-Party Services" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="AptiRise uses Firebase Authentication for sign-in, Cloud Firestore for account profiles, and Cloud Functions for account management and free-hint requests. Practice history and bookmarks remain on this device." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="5. Account &amp; Data Deletion Rights" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="You can delete your account from Profile or the navigation drawer. Account deletion removes your account profile and associated server records. Learning records stored on this device are not backed up to the cloud. For support, contact zeelgajera010@gmail.com." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="6. Data Security" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="We implement industry-standard security measures to safeguard your information:\n• All data in transit between AptiRise and Firebase services is encrypted using HTTPS / TLS encryption.\n• Cloud Firestore security rules strictly enforce user data isolation." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="7. Children's Privacy" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="AptiRise does not knowingly collect personal identifiable information from children under 13. If you believe a child has provided us with personal data, please contact us so we can immediately delete the information." android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:text="8. Contact Us" android:textColor="?attr/colorOnSurface" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="If you have any questions or suggestions regarding this Privacy Policy, please contact us at:\nEmail: zeelgajera010@gmail.com" android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>