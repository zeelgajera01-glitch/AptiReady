<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="@dimen/spacing_20dp" android:paddingTop="@dimen/spacing_16dp" android:paddingEnd="@dimen/spacing_20dp" android:paddingBottom="@dimen/spacing_32dp" android:background="?android:attr/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_16dp" android:text="@string/nav_profile" android:textColor="?attr/colorOnSurface" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_auth_profile" style="?attr/materialCardViewElevatedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_20dp" android:visibility="gone" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="0dp" app:cardBackgroundColor="@color/primary_container">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <ImageView android:id="@+id/iv_avatar" android:layout_width="52dp" android:layout_height="52dp" android:layout_alignParentStart="true" android:contentDescription="@null" android:src="@drawable/ic_profile" app:tint="?attr/colorPrimary" android:background="@drawable/atelier_circle" android:padding="12dp" />
          <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_12dp" android:layout_toStartOf="@id/tv_verified_badge" android:layout_toEndOf="@id/iv_avatar" android:orientation="vertical">
            <TextView android:id="@+id/tv_display_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:textStyle="bold" tools:text="AptiRise Scholar" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tv_auth_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" tools:text="scholar@example.com" />
          </LinearLayout>
          <TextView android:id="@+id/tv_verified_badge" style="@style/Widget.AptiRise.DemoBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="VERIFIED" />
        </RelativeLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_12dp" android:gravity="center_vertical" android:orientation="horizontal">
          <TextView android:id="@+id/tv_daily_goal_summary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" tools:text="Daily Target: 10 Questions / day" />
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_profile" style="@style/Widget.AptiRise.Button.Outline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit Profile" app:cornerRadius="16dp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_section_title" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <RadioGroup android:id="@+id/rg_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_12dp">
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_theme_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/min_touch_target" android:text="@string/theme_system" android:textSize="14sp" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_theme_light" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/min_touch_target" android:text="@string/theme_light" android:textSize="14sp" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_theme_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/min_touch_target" android:text="@string/theme_dark" android:textSize="14sp" />
        </RadioGroup>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_bookmarks_shortcut" style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_20dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/spacing_16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_star" app:tint="?attr/colorPrimary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_12dp" android:layout_weight="1" android:text="Saved Bookmarks" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_sign_out" style="@style/Widget.AptiRise.Button.Outline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginBottom="@dimen/spacing_20dp" android:text="Sign Out" android:visibility="gone" app:cornerRadius="16dp" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_privacy_policy" style="?attr/materialCardViewOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_20dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/spacing_16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_info" app:tint="?attr/colorPrimary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_12dp" android:layout_weight="1" android:text="Privacy Policy" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete_account" style="@style/Widget.AptiRise.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delete Account" android:textColor="@color/difficulty_hard" app:cornerRadius="16dp" android:visibility="gone" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
