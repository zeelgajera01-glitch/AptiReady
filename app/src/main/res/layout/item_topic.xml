<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/card_topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:strokeColor="@color/atelier_border">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_badge" android:src="@drawable/ic_practice" app:tint="?attr/colorPrimary"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_weight="1">
        <TextView android:id="@+id/tv_topic_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="19sp" tools:text="Percentages"/>
        <Space android:layout_width="1dp" android:layout_height="4dp" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/tv_topic_desc" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" tools:text="Base changes and successive percentages"/>
      </LinearLayout>
      <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_arrow_right" app:tint="?attr/colorPrimary"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/tv_topic_category" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" tools:text="QUANTITATIVE" android:layout_weight="1"/>
      <TextView android:id="@+id/tv_topic_difficulty" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:background="@drawable/atelier_peach_badge" android:padding="7dp" tools:text="MEDIUM"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/tv_topic_count" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="13sp" tools:text="60 questions"/>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
