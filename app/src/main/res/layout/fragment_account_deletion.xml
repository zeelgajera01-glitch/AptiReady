<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/spacing_24dp" android:paddingTop="@dimen/spacing_24dp" android:paddingEnd="@dimen/spacing_24dp" android:paddingBottom="@dimen/spacing_32dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/atelier_circle" android:contentDescription="@string/cd_back_button" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:padding="12dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_12dp" android:text="Delete Account &amp; Cloud Data" android:textColor="@color/difficulty_hard" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" />
    <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewElevatedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/atelier_border" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorPrimaryContainer" android:orientation="vertical" android:padding="@dimen/spacing_16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Permanent Account &amp; Data Erasure" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_8dp" android:lineSpacingExtra="4dp" android:text="Your account profile and associated server records will be permanently erased.\nLearning records on this device are stored locally.\nPublic learning content remains available.\nOnce confirmed, account deletion cannot be undone." android:textColor="?attr/colorOnPrimaryContainer" android:textSize="13sp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm_deletion" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_16dp" android:backgroundTint="@color/difficulty_hard" android:text="Permanently Delete My Account" app:cornerRadius="16dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel_deletion" style="@style/Widget.AptiRise.Button.Outline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_12dp" android:text="Cancel &amp; Go Back" app:cornerRadius="16dp" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
