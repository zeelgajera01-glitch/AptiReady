<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground" android:paddingStart="20dp" android:paddingEnd="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="12dp">
    <ImageButton android:id="@+id/btn_exit_session" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:contentDescription="Exit practice" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp" android:layout_weight="1">
      <TextView android:text="Practice session" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" />
      <TextView android:id="@+id/tv_session_topic_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:maxLines="2" tools:text="Percentages" />
    </LinearLayout>
    <ImageButton android:id="@+id/btn_bookmark_toggle" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_atelier_bookmark" app:tint="?attr/colorPrimary" android:contentDescription="Save question" />
  </LinearLayout>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
      <TextView android:id="@+id/tv_session_difficulty" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" tools:text="ALL DIFFICULTIES" />
      <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
      <TextView android:id="@+id/tv_question_counter" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="17sp" tools:text="Question 3 of 10" android:visibility="gone" android:importantForAccessibility="no" />
      <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no" />
      <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/session_progress_bar" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackThickness="6dp" app:trackCornerRadius="3dp" app:indicatorColor="?attr/colorPrimary" app:trackColor="@color/atelier_track" android:indeterminate="false" android:max="100" />
      <Space android:layout_width="1dp" android:layout_height="18dp" android:importantForAccessibility="no" />
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/aptirise_question_panel">
          <TextView android:id="@+id/tv_question_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Question" tools:text="A price rises by 20% and falls by 10%. What is the net percentage change?" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/container_options">
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_option_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
              <TextView android:text="A" android:id="@+id/tv_badge_a" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
              <TextView android:id="@+id/tv_option_a_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="20 seconds" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_option_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
              <TextView android:text="B" android:id="@+id/tv_badge_b" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
              <TextView android:id="@+id/tv_option_b_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="25 seconds" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_option_c" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
              <TextView android:text="C" android:id="@+id/tv_badge_c" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
              <TextView android:id="@+id/tv_option_c_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="18.5 seconds" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_option_d" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="@color/atelier_border" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="36dp">
              <TextView android:text="D" android:id="@+id/tv_badge_d" android:layout_width="34dp" android:layout_height="34dp" style="@style/Text.AptiRise.Eyebrow" android:gravity="center" android:background="@drawable/atelier_circle" android:textColor="?attr/colorOnPrimaryContainer" />
              <TextView android:id="@+id/tv_option_d_text" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:layout_weight="1" android:layout_marginStart="14dp" tools:text="32 seconds" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
      <TextView android:id="@+id/tv_submitted_status" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" android:visibility="gone" />
      <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
      <com.google.android.material.card.MaterialCardView android:id="@+id/card_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:cardBackgroundColor="@color/atelier_soft" android:visibility="gone" app:strokeColor="@color/atelier_border">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
          <TextView android:text="Step-by-Step Explanation" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" android:textSize="18sp" />
          <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
          <TextView android:id="@+id/tv_explanation_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnPrimaryContainer" tools:text="Start with a base value of 100." />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.button.MaterialButton android:text="Use Free Hint (1 total)" android:id="@+id/btn_toggle_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" />
      <TextView android:id="@+id/tv_free_hint_status" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textSize="12sp" android:paddingTop="8dp" android:visibility="gone" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/layout_hint_container" android:padding="16dp" android:background="@drawable/atelier_soft_panel" android:layout_marginTop="12dp" android:visibility="gone">
        <TextView android:id="@+id/tv_hint_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnPrimaryContainer" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/layout_extra_hint_container" android:padding="16dp" android:background="@drawable/atelier_soft_panel" android:visibility="gone">
        <TextView android:id="@+id/tv_extra_hint_text" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:textColor="?attr/colorOnPrimaryContainer" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
      <com.google.android.material.button.MaterialButton android:text="Question Navigator" android:id="@+id/btn_open_navigator" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" app:icon="@drawable/ic_atelier_grid" app:cornerRadius="16dp" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="?attr/colorSurface" android:paddingStart="8dp" android:paddingEnd="8dp">
    <com.google.android.material.button.MaterialButton android:text="Prev" android:id="@+id/btn_prev_question" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
    <com.google.android.material.button.MaterialButton android:text="Submit Answer" android:id="@+id/btn_submit_answer" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Primary" android:layout_weight="2" android:layout_marginStart="8dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
    <com.google.android.material.button.MaterialButton android:text="Next" android:id="@+id/btn_next_question" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" style="@style/Widget.AptiRise.Button.Soft" android:layout_weight="1" android:layout_marginStart="8dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:cornerRadius="16dp" />
  </LinearLayout>
</LinearLayout>
