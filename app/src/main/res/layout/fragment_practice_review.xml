<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:attr/colorBackground" android:paddingStart="20dp" android:paddingEnd="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="16dp">
    <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/atelier_circle" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" android:contentDescription="Navigate back" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
      <TextView android:text="AptiRise" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Section" />
      <TextView android:text="ANSWER REVIEW" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Eyebrow" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/aptirise_hero_gradient" android:padding="24dp" android:layout_marginBottom="12dp">
    <TextView android:text="Answers &amp; Solutions" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Title" android:textColor="@color/brand_on_gradient" />
    <Space android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
    <TextView android:text="Understand the reasoning behind every answer." android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Text.AptiRise.Body" android:id="@+id/tv_review_context" android:textColor="@color/brand_on_gradient_muted" />
    <Space android:layout_width="1dp" android:layout_height="10dp" android:importantForAccessibility="no" />
  </LinearLayout>
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false" android:clipToPadding="false">
    <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_review_filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:chipSpacingHorizontal="6dp">
      <com.google.android.material.chip.Chip android:id="@+id/chip_filter_all" android:text="All" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="true" />
      <com.google.android.material.chip.Chip android:id="@+id/chip_filter_correct" android:text="Correct" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false" />
      <com.google.android.material.chip.Chip android:id="@+id/chip_filter_incorrect" android:text="Incorrect" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false" />
      <com.google.android.material.chip.Chip android:id="@+id/chip_filter_skipped" android:text="Skipped" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.AptiRise.Chip" android:checked="false" />
    </com.google.android.material.chip.ChipGroup>
  </HorizontalScrollView>
  <Space android:layout_width="1dp" android:layout_height="12dp" android:importantForAccessibility="no" />
  <TextView android:id="@+id/tv_empty_review" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="No questions available for this filter." android:visibility="gone" style="@style/Text.AptiRise.Body" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_review_questions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>