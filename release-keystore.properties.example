# Example Release Keystore Configuration Template for AptiRise
# Copy this file to "release-keystore.properties" at the project root and fill in your actual values.
# NEVER commit "release-keystore.properties" or your ".jks" keystore file to version control.

storeFile=release-keystore.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=YOUR_KEY_ALIAS_HERE
keyPassword=YOUR_KEY_PASSWORD_HERE
